{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Poultriq config-lighting-lux",
  "description": "STAGING PROPOSAL for integration; telemetry/status preserve existing v1. Semantic validation and current mapping additionally required.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": "phase8_draft"
    },
    "message_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "coop_id": {
      "type": "integer",
      "minimum": 1
    },
    "device_identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "domain": {
      "const": "lighting_lux"
    },
    "config_version": {
      "type": "integer",
      "minimum": 1
    },
    "settings": {
      "type": "object",
      "properties": {
        "lighting_mode": {
          "enum": [
            "auto",
            "manual"
          ]
        },
        "min_lux": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 65535
        },
        "max_lux": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 65535
        },
        "threshold_unit": {
          "const": "lux"
        },
        "measurement_version": {
          "const": "bh1750_lux_v1"
        }
      },
      "required": [
        "lighting_mode",
        "min_lux",
        "max_lux",
        "threshold_unit",
        "measurement_version"
      ],
      "additionalProperties": false
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "contract",
    "message_id",
    "coop_id",
    "device_identifier",
    "domain",
    "config_version",
    "settings",
    "generated_at",
    "expires_at",
    "payload_hash"
  ],
  "additionalProperties": false
}
