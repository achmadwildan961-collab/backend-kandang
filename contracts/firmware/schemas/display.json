{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Poultriq display",
  "description": "STAGING PROPOSAL for integration; telemetry/status preserve existing v1. Semantic validation and current mapping additionally required.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": "phase8_draft"
    },
    "coop_id": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "target_device_ids": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "fields": {
      "type": "object",
      "properties": {
        "indoor_temperature": {
          "type": "object",
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "unit": {
              "const": "celsius"
            },
            "status": {
              "enum": [
                "fresh",
                "stale",
                "missing",
                "invalid",
                "unsupported",
                "unknown",
                "unavailable",
                "unverified_source"
              ]
            },
            "recorded_at": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "value",
            "unit",
            "status",
            "recorded_at"
          ],
          "additionalProperties": false
        },
        "outdoor_temperature": {
          "type": "object",
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "unit": {
              "const": "celsius"
            },
            "status": {
              "enum": [
                "fresh",
                "stale",
                "missing",
                "invalid",
                "unsupported",
                "unknown",
                "unavailable",
                "unverified_source"
              ]
            },
            "recorded_at": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "value",
            "unit",
            "status",
            "recorded_at"
          ],
          "additionalProperties": false
        },
        "indoor_humidity": {
          "type": "object",
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "unit": {
              "const": "percent"
            },
            "status": {
              "enum": [
                "fresh",
                "stale",
                "missing",
                "invalid",
                "unsupported",
                "unknown",
                "unavailable",
                "unverified_source"
              ]
            },
            "recorded_at": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "unit_symbol": {
              "const": "%"
            }
          },
          "required": [
            "value",
            "unit",
            "status",
            "recorded_at",
            "unit_symbol"
          ],
          "additionalProperties": false
        },
        "outdoor_humidity": {
          "type": "object",
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "unit": {
              "const": "percent"
            },
            "status": {
              "enum": [
                "fresh",
                "stale",
                "missing",
                "invalid",
                "unsupported",
                "unknown",
                "unavailable",
                "unverified_source"
              ]
            },
            "recorded_at": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "unit_symbol": {
              "const": "%"
            }
          },
          "required": [
            "value",
            "unit",
            "status",
            "recorded_at",
            "unit_symbol"
          ],
          "additionalProperties": false
        },
        "gas": {
          "type": "object",
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "unit": {
              "const": "adc"
            },
            "status": {
              "enum": [
                "fresh",
                "stale",
                "missing",
                "invalid",
                "unsupported",
                "unknown",
                "unavailable",
                "unverified_source"
              ]
            },
            "recorded_at": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "value",
            "unit",
            "status",
            "recorded_at"
          ],
          "additionalProperties": false
        },
        "outdoor_light_lux": {
          "type": "object",
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "unit": {
              "const": "lux"
            },
            "status": {
              "enum": [
                "fresh",
                "stale",
                "missing",
                "invalid",
                "unsupported",
                "unknown",
                "unavailable",
                "unverified_source"
              ]
            },
            "recorded_at": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "value",
            "unit",
            "status",
            "recorded_at"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "indoor_temperature",
        "outdoor_temperature",
        "indoor_humidity",
        "outdoor_humidity",
        "gas",
        "outdoor_light_lux"
      ],
      "additionalProperties": false
    },
    "actuators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "integer",
            "minimum": 1
          },
          "online": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "missing",
              "fresh",
              "unavailable"
            ]
          },
          "states": {
            "type": "object",
            "properties": {
              "heating_lamp": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "ventilation_fan_1": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "ventilation_fan_2": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "lighting_lamp": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "heating_lamp",
              "ventilation_fan_1",
              "ventilation_fan_2",
              "lighting_lamp"
            ],
            "additionalProperties": false
          },
          "feedback_kind": {
            "enum": [
              "gpio",
              "physical",
              null
            ]
          },
          "reported_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "physical_verified": {
            "const": false
          }
        },
        "required": [
          "device_id",
          "online",
          "status",
          "states",
          "feedback_kind",
          "reported_at",
          "physical_verified"
        ],
        "additionalProperties": false
      }
    },
    "display_geometry": {
      "type": "null"
    },
    "publication_enabled": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "contract",
    "coop_id",
    "generated_at",
    "expires_at",
    "target_device_ids",
    "fields",
    "actuators",
    "display_geometry",
    "publication_enabled"
  ],
  "additionalProperties": false
}
