APP_NAME="Smart Kandang API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_kandang
DB_USERNAME=smart_kandang
DB_PASSWORD=
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
BCRYPT_ROUNDS=12
SENSOR_STALE_AFTER_SECONDS=300
SANCTUM_EXPIRATION=43200
# Local Flutter Web only. Set explicit HTTPS frontend origins in production.
CORS_ALLOWED_ORIGINS=http://localhost:58111,http://127.0.0.1:58111
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
DEV_USER_EMAIL=
DEV_USER_PASSWORD=

# Disabled until an authenticated broker is available. No remote VM assumed.
MQTT_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=smart-kandang-laravel
MQTT_TOPIC_PREFIX=smart-kandang
MQTT_TLS=false
MQTT_TLS_CA_FILE=
MQTT_OFFLINE_AFTER_SECONDS=120
MQTT_FUTURE_TOLERANCE_SECONDS=30

# MQTT deployment options (replace only after confirming device ownership)
MQTT_RETRY_MIN_SECONDS=2
MQTT_RETRY_MAX_SECONDS=30
MQTT_DEVICE_SENSORS='{}'
