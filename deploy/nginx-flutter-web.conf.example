# Deployment template only. Replace DNS, certificate paths, directories and the
# PHP-FPM socket for VM 2. Run nginx -t on that VM before enabling this file.
server {
    listen 80;
    server_name coop.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name coop.example.com;
    ssl_certificate /etc/letsencrypt/live/coop.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/coop.example.com/privkey.pem;
    root /srv/smart-kandang-web;
    index index.html;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # Build Flutter with --csp --no-web-resources-cdn. If using a different API
    # origin, add that exact HTTPS origin to connect-src and Laravel CORS.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://fonts.gstatic.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; upgrade-insecure-requests" always;
    # Revalidate bootstrap/app files after a deployment, including HTTP errors.
    add_header Cache-Control "no-cache" always;

    location ^~ /api/ {
        # No trailing URI: preserve /api/v1/... at the Laravel upstream.
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
        proxy_cache off;
        proxy_read_timeout 30s;
    }
    location = /up {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
    }
    location ~ /\. { deny all; }
    location ~* \.(?:js|wasm|json|png|jpg|svg|ico|ttf|otf|woff2?)$ {
        try_files $uri =404;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# Private Laravel HTTP upstream on the SAME VM, backed by PHP-FPM.
# Do not expose 8080 externally or use artisan serve as the production server.
server {
    listen 127.0.0.1:8080;
    server_name coop.example.com;
    root /srv/smart-kandang-backend/public;
    location / { try_files $uri /index.php?$query_string; }
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        # Only the local HTTPS proxy reaches this listener. Preserve the client
        # address for login throttling and report the public scheme to Laravel.
        fastcgi_param REMOTE_ADDR $http_x_real_ip;
        fastcgi_param HTTPS on;
        fastcgi_param SERVER_PORT 443;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }
    location ~ /\. { deny all; }
    location ~ \.php$ { return 404; }
}
